{
  "name": "open-vibecoding",
  "version": "0.4.7",
  "description": "Open VibeCoding: product, interaction design, development, and testing workflow for agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mileson/open-vibecoding.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "open-vibecoding": "bin/open-vibecoding.js"
  },
  "files": [
    "CONTRIBUTING.md",
    "README_CN.md",
    "SECURITY.md",
    "docs/test-report.md",
    "docs/project-quality.md",
    "docs/examples/project-quality-ci.yml",
    "docs/examples/photo-selection-project-quality.json",
    "docs/e2e-results.schema.json",
    "docs/examples/photo-selection-e2e/manifest.json",
    "docs/examples/photo-selection-e2e/assets",
    "docs/examples/photo-selection-e2e/ios",
    "docs/examples/photo-selection-e2e/web/*.*",
    ".github/workflows/e2e-run.yml",
    ".github/workflows/e2e.yml",
    "docs/code-quality-report.md",
    "docs/examples/photo-selection-quality.json",
    "docs/examples/photo-selection-test-cases.json",
    "docs/aso-report.md",
    "docs/funnel-report.md",
    "docs/prd-html.md",
    "docs/social-report.md",
    "bin",
    "scripts",
    "src",
    "skills",
    ".open-vibecoding/templates",
    ".open-vibecoding/schema",
    ".open-vibecoding/knowledge/bindings.json",
    "test/fixtures/prd-camera-first-photo.json",
    ".open-vibecoding/README.md",
    ".open-vibecoding/README_EN.md",
    ".open-vibecoding/config.yaml",
    ".open-vibecoding/design",
    ".open-vibecoding/standards"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node ./bin/open-vibecoding.js",
    "release:notes": "node scripts/open-vibecoding-github-release-notes.mjs",
    "test": "node --test",
    "test:smoke": "node --test --test-name-pattern \"quality requires current smoke evidence|run exposes hook-stable\"",
    "test:perf": "node scripts/quality-perf-check.mjs --mode normal",
    "test:perf:extreme": "node scripts/quality-perf-check.mjs --mode extreme --fixture test/fixtures/release-ledger-extreme.json"
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "yaml": "^2.8.2"
  }
}
