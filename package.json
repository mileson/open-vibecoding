{
  "name": "open-vibecoding",
  "version": "0.4.0",
  "description": "Open VibeCoding: product, interaction design, development, and testing workflow for agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mileson/open-vibecoding.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "open-vibecoding": "bin/open-vibecoding.js"
  },
  "files": [
    "CONTRIBUTING.md",
    "README_CN.md",
    "README_EN.md",
    "SECURITY.md",
    "bin",
    "scripts",
    "src",
    ".open-vibecoding",
    "!.open-vibecoding/artifacts",
    "!.open-vibecoding/artifacts/**",
    "!.open-vibecoding/benchmarks/evidence",
    "!.open-vibecoding/benchmarks/evidence/**",
    "!.open-vibecoding/benchmarks/inbox",
    "!.open-vibecoding/benchmarks/inbox/**",
    "!.open-vibecoding/discovery",
    "!.open-vibecoding/discovery/**",
    "!.open-vibecoding/engagements/active/architecture-diagram.html",
    "!.open-vibecoding/engagements/active/architecture-diagram.json",
    "!.open-vibecoding/engagements/active/architecture-diagram.mmd",
    "!.open-vibecoding/engagements/active/brainstorm.html",
    "!.open-vibecoding/engagements/active/brainstorm.json",
    "!.open-vibecoding/harness",
    "!.open-vibecoding/harness/**",
    "!.open-vibecoding/engagements/active/flows.md",
    "!.open-vibecoding/engagements/active/handoff.md",
    "!.open-vibecoding/engagements/active/product-flow-diagram.html",
    "!.open-vibecoding/engagements/active/product-flow-diagram.json",
    "!.open-vibecoding/engagements/active/product-flow-diagram.mmd",
    "!.open-vibecoding/engagements/active/review.html",
    "!.open-vibecoding/engagements/active/roles.md",
    "!.open-vibecoding/engagements/work-units",
    "!.open-vibecoding/engagements/work-units/**",
    "!.open-vibecoding/exports",
    "!.open-vibecoding/exports/**",
    "!.open-vibecoding/learning",
    "!.open-vibecoding/learning/**",
    "!.open-vibecoding/ledger",
    "!.open-vibecoding/ledger/**",
    "!.open-vibecoding/quality/evidence",
    "!.open-vibecoding/quality/evidence/**",
    "!.open-vibecoding/quality/reports",
    "!.open-vibecoding/quality/reports/**",
    "!.open-vibecoding/growth",
    "!.open-vibecoding/growth/**",
    "!.open-vibecoding/growth/preferences.local.json",
    "!.open-vibecoding/knowledge/incidents",
    "!.open-vibecoding/knowledge/incidents/**",
    "!.open-vibecoding/knowledge/patterns",
    "!.open-vibecoding/knowledge/patterns/**",
    "!.open-vibecoding/knowledge/skills",
    "!.open-vibecoding/knowledge/skills/**",
    "!.open-vibecoding/knowledge/adoption.jsonl",
    "!.open-vibecoding/knowledge/candidates",
    "!.open-vibecoding/knowledge/candidates/**",
    "!.open-vibecoding/knowledge/drafts",
    "!.open-vibecoding/knowledge/drafts/**",
    "!.open-vibecoding/knowledge/index.json",
    "!.open-vibecoding/knowledge/review-signals.jsonl",
    "!.open-vibecoding/reviews",
    "!.open-vibecoding/reviews/**",
    "!.open-vibecoding/sessions",
    "!.open-vibecoding/sessions/**",
    "!.open-vibecoding/state/changes.json",
    "!.open-vibecoding/state/current.json",
    "!.open-vibecoding/state/events.jsonl",
    "!.open-vibecoding/state/freeze.json",
    "!.open-vibecoding/state/release-ledger.json",
    "!.open-vibecoding/state/task-graph.json",
    "!.open-vibecoding/state/version-index.json",
    "!.open-vibecoding/state/versions",
    "!.open-vibecoding/state/versions/**",
    "!.open-vibecoding/engagements/active/decision-log.md",
    "!.open-vibecoding/engagements/active/open-questions.md",
    "!.open-vibecoding/engagements/active/progress.md",
    "!.open-vibecoding/engagements/active/verification.md",
    "skills"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node ./bin/open-vibecoding.js",
    "release:notes": "node scripts/open-vibecoding-github-release-notes.mjs",
    "test": "node --test",
    "test:smoke": "node --test --test-name-pattern \"quality requires current smoke evidence|run exposes hook-stable\"",
    "test:perf": "node scripts/quality-perf-check.mjs --mode normal",
    "test:perf:extreme": "node scripts/quality-perf-check.mjs --mode extreme --fixture test/fixtures/release-ledger-extreme.json"
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "yaml": "^2.8.2"
  }
}
