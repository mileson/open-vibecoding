        "returned"
      ],
      "cases": [
        {
          "id": "count",
          "title": "第 10 张操作后仍显示 9 张",
          "expected": 9
        },
        {
          "id": "blocked",
          "title": "第 10 张被拦截",
          "expected": {
            "notice": true,
            "tenthSelected": false
          }
        },
        {
          "id": "selection",
          "title": "选中的 9 张照片身份不变",
          "expected": [
            "P01",
            "P02",
            "P03",
            "P04",
            "P05",
            "P06",
            "P07",
            "P08",
            "P09"
          ]
        },
        {
          "id": "returned",
          "title": "发起页收到同一份照片名单",
          "expected": [
            "P01",
            "P02",
