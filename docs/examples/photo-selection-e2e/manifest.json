          ]
        }
      ],
      "dataPreparation": "ios-photo-selection"
    },
    {
      "id": "maestro-fixed",
      "label": "修复版本 · 完整验收",
      "engine": "maestro",
      "timeoutMs": 900000,
      "environment": {
        "target": "选图 iOS 样例",
        "deviceType": "模拟器",
        "os": "iOS",
        "version": "修复版本"
      },
      "argv": [
        "bash",
        "docs/examples/photo-selection-e2e/ios/run.sh",
        "fixed",
        "{artifacts}",
        "{result}",
        "{observations}",
        "count",
        "blocked",
