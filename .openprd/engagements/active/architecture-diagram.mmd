flowchart LR
  people_agents["用户与 Agent<br/>业务用户负责目标与决策，Codex、Cursor、Claude Code 在授权范围内执行。"]
  subgraph solution["方案边界"]
    review_studio["业务与工程双视图<br/>同一 ReviewModel 生成小白可懂的业务视图和工程可追溯视图。"]
    adapter_spi["跨工具适配层<br/>归一生命周期事件，协商能力并渲染各工具需要的上下文与决定。"]
    context_compiler["上下文编译器<br/>按任务、风险、权限与 token 预算生成稳定 Capsule 或 Delta。"]
    gate_engine[["分级门禁与证据<br/>项目、变更、工作单元、任务、会话和单次操作各自判断。"]]
    task_runtime["并发任务运行态<br/>Lane、claim、lease、heartbeat、write-set 与 CAS 协调多线程执行。"]
    domain_services["需求与项目服务<br/>Change、Task、Review、Quality、Knowledge 与 Migration 只通过控制平面变更事实。"]
    project_ledger["Project Ledger<br/>事件信封、连续 revision、幂等键和可重建投影构成唯一业务真相。"]
    atomic_store["原子存储与版本清单<br/>原子写入、锁、checksum、reader/writer 版本和迁移记录保护旧项目。"]
  end
  people_agents -->|"理解范围、风险与决定"| review_studio
  people_agents -->|"提交任务与运行事件"| adapter_spi
  adapter_spi -->|"协商能力与上下文格式"| context_compiler
  context_compiler -.->|"附带适用门禁与权限"| gate_engine
  gate_engine -.->|"允许后领取任务范围"| task_runtime
  task_runtime -->|"在 claim 与 write-set 内执行"| domain_services
  domain_services -->|"追加事实事件"| project_ledger
  project_ledger -->|"提供最新权威事实"| context_compiler
  project_ledger -->|"生成双投影"| review_studio
  atomic_store -.->|"原子持久化与版本保护"| project_ledger
